;;
;; Samples 8 input pins once per input pixel, starting at the end of each
;; HSync pulse. Two instructions per sample, so the SM runs at twice the
;; pixel clock. Pulled once from the TX FIFO: the phase delay (0 or 1 extra
;; SM cycle, i.e. half a pixel), then the number of samples per line minus
;; one, which stays in the OSR. GPIO 7 is the TTL HSync input.

.program CapturePosHSync
    pull block
    mov y, osr
    pull block
.wrap_target
    wait 1 gpio 7
    wait 0 gpio 7
    mov x, y
delay:
    jmp x-- delay
    mov x, osr
sample:
    in pins, 8
    jmp x-- sample
.wrap

.program CaptureNegHSync
    pull block
    mov y, osr
    pull block
.wrap_target
    wait 0 gpio 7
    wait 1 gpio 7
    mov x, y
delay:
    jmp x-- delay
    mov x, osr
sample:
    in pins, 8
    jmp x-- sample
.wrap

% c-sdk {
static inline pio_sm_config CaptureConfig(uint Offset, bool PosHSync,
                                          uint FirstGPIO, float ClkDiv) {
  pio_sm_config Conf =
      PosHSync ? CapturePosHSync_program_get_default_config(Offset)
               : CaptureNegHSync_program_get_default_config(Offset);
  sm_config_set_in_pins(&Conf, FirstGPIO);
  // Shift right: the first sample ends up in the lowest byte.
  sm_config_set_in_shift(&Conf, /*shift_right=*/true, /*autopush=*/true, 32);
  sm_config_set_clkdiv(&Conf, ClkDiv);
  return Conf;
}
%}
